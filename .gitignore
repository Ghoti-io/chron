# Build output
build

# Debug artifacts (GDB scripts, captured stderr, sanity/trace dumps)
*.gdb
*.txt

# IDE / CTest run output (not used by project Makefile)
Testing

# Third-party / reference source trees (not tracked by name)
third_party

# Documentation generated by Doxygen
docs

# Example output files
example.output.*

# Task documents
tasks

# Test output (e.g. PNGs written by encode tests for verification)
tests/out

# Stray output under test data (use tests/out instead)
tests/data/out


# Pycache files (for generated test fixtures, in any directory)
**/__pycache__

# The embedded time-zone table is generated by tools/tzdata/embed.py during
# the build. It is 2.3MB of TZif images written out as C; regenerating it is
# under a second, and committing it would put a machine-specific snapshot of
# one distribution's tzdata into every diff.
#
# src/zone/windows_zones.c is the other generated table and *is* committed -
# it is ten kilobytes, it changes about as often as Windows adds a time zone,
# and regenerating it needs the network, so a build that had to fetch it would
# be a build that fails without one.
src/zone/tzdata_embedded.c
